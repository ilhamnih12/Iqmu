# ============================================================
# IQMetry - Environment Variables
# ============================================================
# Server-side Gemini API key (AI question generation + deep report).
# Get a free key at https://aistudio.google.com/apikey
# If this is NOT set, the platform still works using the built-in
# 36-question psychometric bank + heuristic AI report fallback.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash —
# the current free-tier stable Flash model recommended by Google
# for new projects).
GEMINI_MODEL=gemini-3.8-flash
